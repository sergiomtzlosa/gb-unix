; hardware.inc — SM83 register definitions used by gb-unix

; Memory-mapped I/O
def rP1          equ $FF00 ; joypad
def rSB          equ $FF01 ; serial data
def rSC          equ $FF02 ; serial control
def rDIV         equ $FF04
def rNR10        equ $FF10 ; ch1 sweep
def rNR11        equ $FF11 ; ch1 duty / length
def rNR12        equ $FF12 ; ch1 envelope
def rNR13        equ $FF13 ; ch1 frequency low
def rNR14        equ $FF14 ; ch1 frequency high / trigger
def rNR21        equ $FF16 ; ch2 duty / length
def rNR22        equ $FF17 ; ch2 envelope
def rNR23        equ $FF18 ; ch2 frequency low
def rNR24        equ $FF19 ; ch2 frequency high / trigger
def rNR41        equ $FF20 ; ch4 length
def rNR42        equ $FF21 ; ch4 envelope
def rNR43        equ $FF22 ; ch4 noise properties
def rNR44        equ $FF23 ; ch4 trigger
def rNR50        equ $FF24 ; master volume / terminals
def rNR51        equ $FF25 ; channel stereo routing
def rNR52        equ $FF26 ; sound power
def rLCDC        equ $FF40
def rSTAT        equ $FF41
def rSCY         equ $FF42
def rSCX         equ $FF43
def rLY          equ $FF44 ; LCD Y coordinate
def rBGP         equ $FF47 ; BG palette
def rIE          equ $FFFF ; interrupt enable

; LCDC bits
def LCDC_ON      equ $80
def LCDC_TILE8000 equ $10  ; BG tiles at $8000, unsigned
def LCDC_MAP9800 equ $00   ; BG tilemap at $9800 (bit3 CLEAR selects $9800)
def LCDC_BG_ON   equ $01

; Joypad bit masks (as returned by input_update in joy_held/joy_pressed)
def J_A          equ $01
def J_B          equ $02
def J_SELECT     equ $04
def J_START      equ $08
def J_RIGHT      equ $10
def J_LEFT       equ $20
def J_UP         equ $40
def J_DOWN       equ $80

; Modes
def MODE_BROWSER equ 0
def MODE_SHELL   equ 1
def MODE_PAGER   equ 2
def MODE_TITLE   equ 3
def MODE_HELP    equ 4

; On-screen keyboard dimensions (shared with shell input handling)
def KB_ROWS      equ 6
def KB_COLS      equ 10
def KB_SCREEN_TOP equ 12

; Text screen (20x18 characters)
def SCREEN_W     equ 20
def SCREEN_H     equ 18
def INVERT_BASE  equ 95          ; inverted font copy = tile index + 95
def BLIT_BUDGET  equ 5           ; max rows copied per frame (VBlank-safe)

; Splash logo tiles (generated by tools/genlogo.py into src/logodata.asm)
def LOGO_TILE_BASE equ 190       ; first free tile after font + inverted copy
def LOGO_ROWS      equ 3         ; splash art tile rows
def LOGO_TILES     equ 60        ; 3 tile rows x 20 tiles
